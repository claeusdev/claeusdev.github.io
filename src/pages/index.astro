---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";
import {
  PROJECTS,
  EMAIL,
  GITHUB_USERNAME,
  TWITTER_USERNAME,
  LINKEDIN_URL,
  AUTHOR,
  SITE_DESCRIPTION,
} from "../consts";

// Show a curated handful of projects on the homepage.
const featuredProjects = PROJECTS.slice(0, 6);

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: AUTHOR,
  description: SITE_DESCRIPTION,
  email: `mailto:${EMAIL}`,
  url: new URL("/", Astro.site).href,
  jobTitle: "Software Engineer and Independent Researcher",
  sameAs: [
    `https://github.com/${GITHUB_USERNAME}`,
    LINKEDIN_URL,
    `https://twitter.com/${TWITTER_USERNAME}`,
  ],
};

// Get recent posts (latest 5)
const posts = (await getCollection("posts"))
  .filter((post) => !post.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 5);

// Get research papers
const research = (await getCollection("research"))
  .filter((paper) => !paper.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);

function formatDate(date: Date): string {
  return date.toLocaleDateString("en-US", {
    year: "numeric",
    month: "long",
    day: "numeric",
  });
}
---

<BaseLayout jsonLd={jsonLd}>
  <div class="container">
    <!-- Bio Section — text + photo side by side -->
    <section class="bio-section">
      <div class="bio-content">
        <div class="bio-text">
          <p class="eyebrow">Software Engineer · Independent Researcher</p>
          <h1 class="bio-name">{AUTHOR}</h1>
          <p>
            I'm a software engineer and independent researcher focused on how
            programs are specified, reasoned about, and made reliable through
            programming language theory, semantics, and formal methods. I hold
            an MSc in Advanced Computer Science from the
            <a href="https://le.ac.uk">University of Leicester</a>, where my
            thesis focused on operational semantics.
          </p>
          <p>
            I'm currently a Product Engineer at
            <a href="https://hello-charles.com">charles</a> in Berlin, and was
            previously a frontend product engineer at
            <a href="https://www.suitepad.de">SuitePad</a>. Before that, I
            worked at companies including
            <a href="https://rhino.com">Rhino</a>,
            <a href="https://leafly.com">Leafly</a>,
            <a href="https://andela.com">Andela</a>, and
            <a href="https://housinganywhere.com">HousingAnywhere</a>, spanning
            frontend, backend, and infrastructure. I continue independent
            research and writing at the intersection of programming language
            theory, semantics, and practical systems.
          </p>
          <p>
            I'm on
            <a href={`https://github.com/${GITHUB_USERNAME}`}>GitHub</a>,
            <a href={LINKEDIN_URL}>LinkedIn</a>, and
            <a href={`https://twitter.com/${TWITTER_USERNAME}`}>Twitter</a>. To
            get in touch, email me at
            <a href={`mailto:${EMAIL}`}>{EMAIL}</a>.
          </p>
        </div>
        <img
          src="https://avatars.githubusercontent.com/u/17507528?v=4"
          alt="Nana Adjei Manu"
          class="bio-photo"
        />
      </div>
    </section>

    <!-- Open Source Projects -->
    <section class="section">
      <h2>Open Source</h2>
      <p class="section-lede">
        Tools and libraries across programming languages, systems, and tooling.
        More on <a href={`https://github.com/${GITHUB_USERNAME}`}>GitHub</a>.
      </p>
      <div class="project-grid">
        {
          featuredProjects.map((project) => (
            <a
              href={project.url}
              target="_blank"
              rel="noopener"
              class="project-card"
            >
              <span class="project-card-name">{project.name}</span>
              <span class="project-card-desc">{project.description}</span>
              {project.tags && (
                <span class="tag-list">
                  {project.tags.map((tag) => (
                    <span class="tag">{tag}</span>
                  ))}
                </span>
              )}
            </a>
          ))
        }
      </div>
      <p class="section-more">
        <a href="/projects">All projects →</a>
      </p>
    </section>

    <!-- Selected Publications -->
    {
      research.length > 0 && (
        <section class="section">
          <h2>Selected Publications</h2>
          <div class="publications-list">
            {research.map((paper) => (
              <div class="publication-item">
                <a href={`/research/${paper.slug}/`} class="publication-title">
                  {paper.data.title}
                </a>
                {paper.data.venue && (
                  <p class="publication-venue">{paper.data.venue}</p>
                )}
              </div>
            ))}
          </div>
          <p>
            <a href="/research">All papers →</a>
          </p>
        </section>
      )
    }

    <!-- Recent Blog Posts -->
    <section class="section">
      <h2>Recent Posts</h2>
      <div class="post-list">
        {
          posts.map((post) => (
            <article class="post-item">
              <a href={`/posts/${post.slug}/`} class="post-link">
                {post.data.title}
              </a>
              <time class="post-date" datetime={post.data.date.toISOString()}>
                {formatDate(post.data.date)}
              </time>
            </article>
          ))
        }
      </div>
      <p class="section-more">
        <a href="/posts">All posts →</a>
      </p>
    </section>
  </div>
</BaseLayout>

<style>
  .bio-section {
    margin-bottom: var(--space-2xl);
  }

  .bio-content {
    display: flex;
    gap: var(--space-xl);
    align-items: flex-start;
  }

  .bio-text {
    flex: 1;
  }

  .bio-name {
    font-size: var(--text-4xl);
    margin: 0 0 var(--space-md);
    line-height: 1.1;
  }

  .bio-photo {
    width: 150px;
    height: 150px;
    min-width: 150px;
    object-fit: cover;
    flex-shrink: 0;
    border-radius: var(--radius-lg);
    border: 1px solid var(--color-border);
  }

  .section-lede {
    color: var(--color-text-secondary);
    margin-bottom: var(--space-lg);
  }

  .section-more {
    margin-top: var(--space-lg);
    font-family: var(--font-sans);
    font-size: var(--text-sm);
  }

  .project-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-md);
  }

  .project-card {
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
    padding: var(--space-md);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    text-decoration: none;
    color: inherit;
    transition: border-color var(--transition), background var(--transition);
  }

  .project-card:hover {
    border-color: var(--color-accent);
    background: var(--color-accent-light);
    text-decoration: none;
  }

  .project-card-name {
    font-family: var(--font-sans);
    font-weight: 600;
    color: var(--color-text);
  }

  .project-card-desc {
    font-size: var(--text-sm);
    color: var(--color-text-secondary);
    line-height: 1.6;
    flex: 1;
  }

  @media (max-width: 640px) {
    .bio-content {
      flex-direction: column-reverse;
      align-items: flex-start;
    }

    .bio-photo {
      width: 110px;
      height: 110px;
      min-width: 110px;
    }

    .project-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
