---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";
import {
  PROJECTS,
  EMAIL,
  GITHUB_USERNAME,
  TWITTER_USERNAME,
  LINKEDIN_URL,
} from "../consts";

// Get recent posts (latest 5)
const posts = (await getCollection("posts"))
  .filter((post) => !post.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 5);

// Get research papers
const research = (await getCollection("research"))
  .filter((paper) => !paper.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);

function formatDate(date: Date): string {
  return date.toLocaleDateString("en-US", {
    year: "numeric",
    month: "long",
    day: "numeric",
  });
}
---

<BaseLayout>
  <div class="container">
    <!-- Bio Section — text + photo side by side -->
    <section class="bio-section">
      <div class="bio-content">
        <div class="bio-text">
          <p>
            I'm a software engineer and independent researcher focused on how
            programs are specified, reasoned about, and made reliable through
            programming language theory, semantics, and formal methods. I hold
            an MSc in Advanced Computer Science from the
            <a href="https://le.ac.uk">University of Leicester</a>, where my
            thesis focused on operational semantics.
          </p>
          <p>
            I've worked at companies including
            <a href="https://rhino.com">Rhino</a>,
            <a href="https://leafly.com">Leafly</a>,
            <a href="https://andela.com">Andela</a>, and
            <a href="https://housinganywhere.com">HousingAnywhere</a>. My work
            has spanned frontend, backend, and infrastructure. I continue
            independent research and writing at the intersection of programming
            language theory, semantics, and practical systems.
          </p>
          <p>
            I'm on
            <a href={`https://github.com/${GITHUB_USERNAME}`}>GitHub</a>,
            <a href={LINKEDIN_URL}>LinkedIn</a>, and
            <a href={`https://twitter.com/${TWITTER_USERNAME}`}>Twitter</a>. To
            get in touch, email me at
            <a href={`mailto:${EMAIL}`}>{EMAIL}</a>.
          </p>
        </div>
        <img
          src="https://avatars.githubusercontent.com/u/17507528?v=4"
          alt="Nana Adjei Manu"
          class="bio-photo"
        />
      </div>
    </section>

    <!-- Open Source Projects -->
    <section class="section">
      <h2>Open Source Projects</h2>
      <p>
        I build tools and libraries across programming languages, systems, and
        tooling. All projects can be found on
        <a href={`https://github.com/${GITHUB_USERNAME}`}>my GitHub page</a>.
        Some of my projects include:
      </p>
      <ul class="project-bullets">
        {
          PROJECTS.map((project) => (
            <li>
              <div>
                <a href={project.url} target="_blank" rel="noopener">
                  <strong>{project.name}</strong>
                </a>{" "}
                - {project.description}
              </div>
              {project.tags && (
                <div class="tag-list">
                  {project.tags.map((tag) => (
                    <span class="tag">{tag}</span>
                  ))}
                </div>
              )}
            </li>
          ))
        }
      </ul>
    </section>

    <!-- Selected Publications -->
    {
      research.length > 0 && (
        <section class="section">
          <h2>Selected Publications</h2>
          <div class="publications-list">
            {research.map((paper) => (
              <div class="publication-item">
                <a href={`/research/${paper.slug}/`} class="publication-title">
                  {paper.data.title}
                </a>
                {paper.data.venue && (
                  <p class="publication-venue">{paper.data.venue}</p>
                )}
              </div>
            ))}
          </div>
          <p>
            <a href="/research">All papers →</a>
          </p>
        </section>
      )
    }

    <!-- Recent Blog Posts -->
    <section class="section">
      <h2>Recent Posts</h2>
      <ul class="post-bullets">
        {
          posts.map((post) => (
            <li>
              <a href={`/posts/${post.slug}/`}>{post.data.title}</a>
              <span class="post-date-inline">
                , {formatDate(post.data.date)}
              </span>
            </li>
          ))
        }
      </ul>
      <p>
        <a href="/posts">All posts →</a>
      </p>
    </section>
  </div>
</BaseLayout>

<style>
  .bio-section {
    margin-bottom: var(--space-xl);
  }

  .bio-content {
    display: flex;
    gap: var(--space-xl);
    align-items: flex-start;
  }

  .bio-text {
    flex: 1;
  }

  .bio-photo {
    width: 160px;
    height: 160px;
    min-width: 160px;
    object-fit: cover;
    flex-shrink: 0;
    border-radius: 6px;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
  }

  .project-bullets {
    margin: var(--space-sm) 0 var(--space-md);
    padding-left: 2rem;
  }

  .project-bullets li {
    margin-bottom: var(--space-sm);
  }

  .project-bullets a {
    color: var(--color-link);
  }

  .post-bullets {
    margin: var(--space-sm) 0 var(--space-md);
    padding-left: 2rem;
    list-style: disc;
  }

  .post-bullets li {
    margin-bottom: var(--space-xs);
  }

  .post-date-inline {
    color: var(--color-text-muted);
    font-size: var(--text-sm);
  }

  @media (max-width: 640px) {
    .bio-content {
      flex-direction: column;
    }

    .bio-photo {
      width: 120px;
      height: 120px;
    }
  }
</style>
