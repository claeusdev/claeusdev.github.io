---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";
import {
  PROJECTS,
  EMAIL,
  GITHUB_USERNAME,
  TWITTER_USERNAME,
  LINKEDIN_URL,
  AUTHOR,
  SITE_DESCRIPTION,
} from "../consts";

// A curated handful of projects, presented as a plain list.
const featuredProjects = PROJECTS.slice(0, 6);

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: AUTHOR,
  description: SITE_DESCRIPTION,
  email: `mailto:${EMAIL}`,
  url: new URL("/", Astro.site).href,
  jobTitle: "Product Engineer",
  sameAs: [
    `https://github.com/${GITHUB_USERNAME}`,
    LINKEDIN_URL,
    `https://twitter.com/${TWITTER_USERNAME}`,
  ],
};

// Recent posts (latest 5)
const posts = (await getCollection("posts"))
  .filter((post) => !post.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 5);

function formatDate(date: Date): string {
  return date.toLocaleDateString("en-US", {
    year: "numeric",
    month: "short",
    day: "numeric",
  });
}
---

<BaseLayout jsonLd={jsonLd}>
  <div class="container home">
    <!-- The site header carries the name; this completes the sentence. -->
    <h1 class="opener">
      <span class="quiet">is a</span> product engineer,<br />
      <span class="quiet">an</span> open-source builder,<br />
      <span class="quiet">and a</span> writer.
    </h1>

    <div class="intro">
      <p>
        I work at <a href="https://hello-charles.com">charles</a> in Berlin,
        building AI-native conversational commerce for consumer brands.
      </p>
      <p>
        Product engineering, for me, means owning the whole slice — from
        database schema to pixels, from idea to production, and the metrics
        after launch.
      </p>
      <p>
        I've done that for eight years across frontend, backend, and
        infrastructure at
        <a href="https://www.suitepad.de">SuitePad</a>,
        <a href="https://housinganywhere.com">HousingAnywhere</a>,
        <a href="https://andela.com">Andela</a>,
        <a href="https://rhino.com">Rhino</a>, and
        <a href="https://leafly.com">Leafly</a>.
      </p>
      <p>
        I care about <em>type systems</em>, <em>fast interfaces</em>, and
        software that doesn't fall over.
      </p>
    </div>

    <p class="list-label">Notable open-source work</p>

    <div class="oss-list">
      {
        featuredProjects.map((project) => (
          <div class="oss-item">
            <span class="oss-desc">
              {project.description}
              {project.tags && (
                <span class="oss-tags">{project.tags.join(" · ")}</span>
              )}
            </span>
            <span class="oss-name">
              <a href={project.url} target="_blank" rel="noopener">
                {project.name}
              </a>
              <span class="oss-arrow" aria-hidden="true">↗</span>
            </span>
          </div>
        ))
      }
    </div>

    <p class="list-label">Recent writing</p>

    <div class="writing-list">
      {
        posts.map((post) => (
          <article class="writing-item">
            <a href={`/posts/${post.slug}/`}>{post.data.title}</a>
            <time datetime={post.data.date.toISOString()}>
              {formatDate(post.data.date)}
            </time>
          </article>
        ))
      }
    </div>

    <div class="outro">
      <p>
        More on the <a href="/posts">blog</a> and the
        <a href="/projects">projects</a> page. I'm on
        <a href={`https://github.com/${GITHUB_USERNAME}`}>GitHub</a>,
        <a href={LINKEDIN_URL}>LinkedIn</a>, and
        <a href={`https://twitter.com/${TWITTER_USERNAME}`}>Twitter</a> — or
        email me at <a href={`mailto:${EMAIL}`}>{EMAIL}</a>.
      </p>
    </div>
  </div>
</BaseLayout>

<style>
  .home {
    padding-top: 0;
  }

  /* Broken-line opener that reads as a continuation of the header name */
  .opener {
    font-size: var(--text-xl);
    font-weight: 600;
    line-height: 1.5;
    letter-spacing: -0.01em;
    margin: 0 0 var(--space-2xl);
  }

  .opener .quiet {
    font-family: var(--font-serif);
    font-style: italic;
    font-weight: 400;
    letter-spacing: 0;
    color: var(--color-text-muted);
  }

  .intro p,
  .outro p {
    max-width: 60ch;
  }

  .intro a,
  .outro a {
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 2px;
    text-decoration-color: color-mix(in srgb, var(--color-link) 40%, transparent);
  }

  .intro a:hover,
  .outro a:hover {
    text-decoration-color: var(--color-link);
  }

  .intro em {
    font-family: var(--font-serif);
    font-size: 1.06em;
  }

  .list-label {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--color-text-muted);
    margin: var(--space-3xl) 0 var(--space-lg);
  }

  .oss-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
  }

  .oss-item {
    display: grid;
    grid-template-columns: 1fr 11rem;
    gap: var(--space-md);
    align-items: baseline;
  }

  .oss-name {
    font-weight: 600;
    text-align: right;
    white-space: nowrap;
  }

  .oss-name a {
    text-decoration: none;
  }

  .oss-name a:hover {
    text-decoration: underline;
  }

  .oss-arrow {
    font-size: var(--text-xs);
    color: var(--color-text-muted);
    margin-left: 0.25em;
    display: inline-block;
    transition: color var(--transition), transform var(--transition);
  }

  .oss-item:hover .oss-arrow {
    color: var(--color-link-hover);
    transform: translate(1px, -1px);
  }

  .oss-desc {
    color: var(--color-text-secondary);
  }

  .oss-tags {
    display: block;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-text-muted);
    margin-top: 0.2rem;
  }

  .writing-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
  }

  .writing-item {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--space-md);
  }

  .writing-item a {
    text-decoration: none;
  }

  .writing-item a:hover {
    text-decoration: underline;
  }

  .writing-item time {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-text-muted);
    white-space: nowrap;
  }

  .outro {
    margin-top: var(--space-2xl);
  }

  @media (max-width: 640px) {
    .oss-item {
      grid-template-columns: 1fr;
      gap: var(--space-xs);
    }

    /* Stacked: lead with the project name again */
    .oss-name {
      order: -1;
      text-align: left;
    }

    .writing-item {
      flex-direction: column;
      gap: 0.15rem;
    }
  }
</style>
