---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";

// Get recent posts (latest 5)
const posts = (await getCollection("posts"))
  .filter((post) => !post.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 5);

// Get research papers
const research = (await getCollection("research"))
  .filter((paper) => !paper.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);

// Better date formatting - full date with day
function formatDate(date: Date): string {
  return date.toLocaleDateString("en-US", {
    year: "numeric",
    month: "long",
    day: "numeric",
  });
}

// Research interests
const researchInterests = [
  {
    area: "Programming Language Theory",
    description:
      "Type systems, language semantics, interpreters, and formal models",
  },
  {
    area: "Semantics and Formal Methods",
    description:
      "Operational semantics, proof-oriented reasoning, and program correctness",
  },
  {
    area: "Data and Systems",
    description:
      "Data-intensive systems, reliability, and practical tooling for research",
  },
];
---

<BaseLayout>
  <div class="container">
    <!-- Hero Section with Photo -->
    <section class="hero">
      <div class="hero-intro">
        <img
          src="https://avatars.githubusercontent.com/u/17507528?v=4"
          alt="Nana Adjei Manu"
          class="profile-photo"
        />
        <div class="hero-content">
          <h1 class="hero-title">Nana Adjei Manu</h1>
          <p class="hero-subtitle">
            I am a software engineer and independent researcher focused on how
            programs are specified, reasoned about, and made reliable through
            programming language theory, semantics, and formal methods.
          </p>
          <div class="hero-links">
            <a href="mailto:n.k.a.manu06@gmail.com" class="hero-link">Email</a>
            <a
              href="https://github.com/naamanu"
              class="hero-link"
              target="_blank"
              rel="noopener">GitHub</a
            >
            <a
              href="https://linkedin.com/in/nana-adjei-manu"
              class="hero-link"
              target="_blank"
              rel="noopener">LinkedIn</a
            >
            <a
              href="https://twitter.com/nmanu__"
              class="hero-link"
              target="_blank"
              rel="noopener">Twitter</a
            >
          </div>
        </div>
      </div>
    </section>

    <!-- Research Interests -->
    <section class="section">
      <div class="section-header">
        <h2 class="section-title">Research Interests</h2>
      </div>
      <div class="interests-list">
        {
          researchInterests.map((interest) => (
            <div class="interest-item">
              <span class="interest-area">{interest.area}</span>
              <span class="interest-desc">{interest.description}</span>
            </div>
          ))
        }
      </div>
    </section>

    <!-- Research Section -->
    {
      research.length > 0 && (
        <section class="section">
          <div class="section-header">
            <h2 class="section-title">Selected Publications</h2>
            <a href="/research" class="section-link">
              All papers →
            </a>
          </div>
          <div class="publications-list">
            {research.map((paper) => (
              <div class="publication-item">
                <a href={`/research/${paper.slug}/`} class="publication-title">
                  {paper.data.title}
                </a>
                {paper.data.venue && (
                  <p class="publication-venue">{paper.data.venue}</p>
                )}
              </div>
            ))}
          </div>
        </section>
      )
    }

    <!-- Blog Section -->
    <section class="section">
      <div class="section-header">
        <h2 class="section-title">Blog</h2>
        <a href="/posts" class="section-link">All posts →</a>
      </div>
      <div class="post-list">
        {
          posts.map((post) => (
            <article class="post-item">
              <a href={`/posts/${post.slug}/`} class="post-link">
                {post.data.title}
              </a>
              <time class="post-date" datetime={post.data.date.toISOString()}>
                {formatDate(post.data.date)}
              </time>
            </article>
          ))
        }
      </div>
    </section>

    <!-- Background Section -->
    <section class="section">
      <div class="section-header">
        <h2 class="section-title">Background</h2>
      </div>
      <p>
        I've worked as a software engineer at companies including
        <a href="https://rhino.com">Rhino</a>,
        <a href="https://leafly.com">Leafly</a>,
        <a href="https://andela.com">Andela</a>, and
        <a href="https://housinganywhere.com">HousingAnywhere</a>. My work has
        spanned frontend, backend, and infrastructure.
      </p>
      <p>
        I hold an MSc in Advanced Computer Science from the University of
        Leicester (Distinction), where my thesis focused on operational
        semantics. I continue independent research and writing at the
        intersection of programming language theory, semantics, and practical
        systems.
      </p>
    </section>
  </div>
</BaseLayout>

<style>
  .hero-intro {
    display: flex;
    gap: var(--space-lg);
    align-items: flex-start;
  }

  .profile-photo {
    width: 96px;
    height: 96px;
    border-radius: 4px;
    object-fit: cover;
    flex-shrink: 0;
    border: 1px solid var(--color-border);
  }

  .hero-content {
    flex: 1;
  }

  .interests-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
  }

  .interest-item {
    display: flex;
    gap: var(--space-md);
  }

  .interest-area {
    font-weight: 600;
    color: var(--color-text);
    min-width: 260px;
    flex-shrink: 0;
  }

  .interest-desc {
    color: var(--color-text-secondary);
    font-size: var(--text-sm);
  }

  .publications-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
  }

  .publication-item {
    padding-bottom: var(--space-sm);
    border-bottom: 1px solid var(--color-border-light);
  }

  .publication-item:last-child {
    border-bottom: none;
  }

  .publication-title {
    font-weight: 500;
    color: var(--color-text);
    text-decoration: none;
    display: block;
    margin-bottom: var(--space-xs);
  }

  .publication-title:hover {
    color: var(--color-link);
  }

  .publication-venue {
    font-size: var(--text-sm);
    color: var(--color-text-secondary);
    font-style: italic;
    margin: 0;
  }

  @media (max-width: 640px) {
    .hero-intro {
      flex-direction: column;
      align-items: flex-start;
      text-align: left;
    }

    .profile-photo {
      width: 88px;
      height: 88px;
    }

    .hero-links {
      justify-content: flex-start;
    }

    .interest-item {
      flex-direction: column;
      gap: var(--space-xs);
    }

    .interest-area {
      min-width: auto;
    }
  }
</style>
