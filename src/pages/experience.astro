---
import BaseLayout from "../layouts/BaseLayout.astro";
import { EXPERIENCE, PUBLICATIONS } from "../consts";
---

<BaseLayout
  title="CV"
  description="Curriculum Vitae - Education, experience, and publications."
>
  <div class="container">
    <section class="hero" style="padding-bottom: var(--space-lg);">
      <h1 class="hero-title">Curriculum Vitae</h1>
    </section>

    <!-- Education -->
    <section class="section">
      <div class="section-header">
        <h2 class="section-title">Education</h2>
      </div>
      <div class="cv-item">
        <div class="cv-header">
          <h3 class="cv-title">M.Sc. Advanced Computer Science</h3>
          <span class="cv-date">Distinction</span>
        </div>
        <p class="cv-org">University of Leicester, UK</p>
      </div>
    </section>

    <!-- Work Experience -->
    <section class="section">
      <div class="section-header">
        <h2 class="section-title">Experience</h2>
      </div>
      <div class="experience-list">
        {
          EXPERIENCE.map((job) => (
            <div class="experience-item">
              <div class="experience-header">
                <div>
                  <h3 class="experience-role">{job.role}</h3>
                  <p class="experience-org">
                    {job.company}, {job.location}
                  </p>
                </div>
                <span class="experience-date">{job.duration}</span>
              </div>
              <ul class="experience-details">
                {job.details.map((detail) => (
                  <li
                    set:html={detail.replace(
                      /\*\*(.*?)\*\*/g,
                      "<strong>$1</strong>",
                    )}
                  />
                ))}
              </ul>
            </div>
          ))
        }
      </div>
    </section>

    <!-- Publications -->
    {
      PUBLICATIONS && PUBLICATIONS.length > 0 && (
        <section class="section">
          <div class="section-header">
            <h2 class="section-title">Publications</h2>
          </div>
          <div class="publications-list">
            {PUBLICATIONS.map((pub) => (
              <div class="pub-item">
                <p class="pub-title">{pub.title}</p>
                <p class="pub-authors">{pub.authors}</p>
                <p class="pub-venue">
                  {pub.venue}, {pub.year}
                </p>
              </div>
            ))}
          </div>
        </section>
      )
    }

    <!-- Skills -->
    <section class="section">
      <div class="section-header">
        <h2 class="section-title">Skills</h2>
      </div>
      <div class="skills-list">
        <div class="skill-row">
          <span class="skill-label">Languages</span>
          <span class="skill-value"
            >TypeScript, Go, Ruby, Python, C/C++, Rust, OCaml, Haskell</span
          >
        </div>
        <div class="skill-row">
          <span class="skill-label">Frameworks</span>
          <span class="skill-value"
            >React, Rails, FastAPI, GraphQL, Sidekiq</span
          >
        </div>
        <div class="skill-row">
          <span class="skill-label">Infrastructure</span>
          <span class="skill-value">PostgreSQL, Redis, Docker, AWS, GCP</span>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .cv-item {
    padding: var(--space-sm) 0;
  }

  .cv-header {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
  }

  .cv-title {
    font-size: var(--text-base);
    font-weight: 600;
    margin: 0;
  }

  .cv-date {
    font-size: var(--text-sm);
    font-family: var(--font-mono);
    color: var(--color-text-muted);
  }

  .cv-org {
    font-size: var(--text-sm);
    color: var(--color-text-secondary);
    margin: var(--space-xs) 0 0 0;
  }

  .experience-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    margin-bottom: var(--space-sm);
  }

  .experience-role {
    font-size: var(--text-base);
    font-weight: 600;
    margin: 0;
  }

  .experience-org {
    font-size: var(--text-sm);
    color: var(--color-text-secondary);
    margin: var(--space-xs) 0 0 0;
  }

  .experience-date {
    font-size: var(--text-sm);
    font-family: var(--font-mono);
    color: var(--color-text-muted);
    white-space: nowrap;
  }

  .publications-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
  }

  .pub-item {
    padding-bottom: var(--space-md);
    border-bottom: 1px solid var(--color-border-light);
  }

  .pub-item:last-child {
    border-bottom: none;
  }

  .pub-title {
    font-weight: 500;
    color: var(--color-text);
    margin: 0 0 var(--space-xs) 0;
  }

  .pub-authors {
    font-size: var(--text-sm);
    color: var(--color-text-secondary);
    margin: 0 0 var(--space-xs) 0;
  }

  .pub-venue {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    font-style: italic;
    margin: 0;
  }

  .skills-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
  }

  .skill-row {
    display: flex;
    gap: var(--space-lg);
  }

  .skill-label {
    font-size: var(--text-sm);
    font-weight: 500;
    color: var(--color-text-muted);
    min-width: 100px;
  }

  .skill-value {
    font-size: var(--text-sm);
    color: var(--color-text-secondary);
  }

  @media (max-width: 640px) {
    .experience-header {
      flex-direction: column;
      gap: var(--space-xs);
    }

    .cv-header {
      flex-direction: column;
      gap: var(--space-xs);
    }

    .skill-row {
      flex-direction: column;
      gap: var(--space-xs);
    }
  }
</style>
