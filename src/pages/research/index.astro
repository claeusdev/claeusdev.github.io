---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";

const research = (await getCollection("research"))
  .filter((paper) => !paper.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

function formatDate(date: Date): string {
  return date.toLocaleDateString("en-US", {
    year: "numeric",
    month: "short",
  });
}

function getStatusBadge(status: string | undefined) {
  const statusMap: Record<string, { label: string; class: string }> = {
    draft: { label: "Draft", class: "status-draft" },
    preprint: { label: "Preprint", class: "status-preprint" },
    "in-review": { label: "In Review", class: "status-review" },
    published: { label: "Published", class: "status-published" },
  };
  return statusMap[status || "draft"] || statusMap.draft;
}
---

<BaseLayout
  title="Research"
  description="Academic research, papers, and technical explorations."
>
  <div class="container">
    <section class="hero" style="padding-bottom: var(--space-xl);">
      <h1 class="hero-title">Research</h1>
      <p class="hero-subtitle">
        Academic work, technical papers, and explorations at the intersection of
        programming languages and systems.
      </p>
    </section>

    {
      research.length === 0 ? (
        <section class="section">
          <div class="empty-state">
            <p class="empty-message">
              No research papers published yet. Check back soon!
            </p>
          </div>
        </section>
      ) : (
        <section class="section">
          <div class="research-list">
            {research.map((paper) => {
              const status = getStatusBadge(paper.data.publicationStatus);
              return (
                <article class="research-item">
                  <div class="research-header">
                    <span class={`status-badge ${status.class}`}>
                      {status.label}
                    </span>
                    <time
                      class="research-date"
                      datetime={paper.data.date.toISOString()}
                    >
                      {formatDate(paper.data.date)}
                    </time>
                  </div>
                  <a href={`/research/${paper.slug}/`} class="research-link">
                    <h3 class="research-title">{paper.data.title}</h3>
                  </a>
                  {paper.data.venue && (
                    <p class="research-venue">{paper.data.venue}</p>
                  )}
                  {paper.data.abstract && (
                    <p class="research-abstract">{paper.data.abstract}</p>
                  )}
                  {paper.data.coAuthors && paper.data.coAuthors.length > 0 && (
                    <p class="research-authors">
                      with {paper.data.coAuthors.join(", ")}
                    </p>
                  )}
                  <div class="research-links">
                    <a href={`/research/${paper.slug}/`} class="paper-link">
                      Read Paper →
                    </a>
                    {paper.data.pdfUrl && (
                      <a
                        href={paper.data.pdfUrl}
                        class="paper-link pdf-link"
                        target="_blank"
                        rel="noopener"
                      >
                        PDF ↗
                      </a>
                    )}
                    {paper.data.arxivUrl && (
                      <a
                        href={paper.data.arxivUrl}
                        class="paper-link arxiv-link"
                        target="_blank"
                        rel="noopener"
                      >
                        arXiv ↗
                      </a>
                    )}
                  </div>
                </article>
              );
            })}
          </div>
        </section>
      )
    }
  </div>
</BaseLayout>

<style>
  .empty-state {
    text-align: center;
    padding: var(--space-3xl) 0;
  }

  .empty-message {
    color: var(--color-text-secondary);
    font-size: var(--text-lg);
  }

  .research-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-xl);
  }

  .research-item {
    padding: var(--space-xl);
    background: var(--color-bg-secondary);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    opacity: 0;
    transform: translateY(20px);
    transition:
      opacity 0.6s ease-out,
      transform 0.6s ease-out,
      border-color 0.2s ease;
  }

  .research-item.animate-in {
    opacity: 1;
    transform: translateY(0);
  }

  .research-item:hover {
    border-color: var(--color-accent);
  }

  .research-header {
    display: flex;
    align-items: center;
    gap: var(--space-md);
    margin-bottom: var(--space-sm);
  }

  .status-badge {
    font-size: var(--text-xs);
    font-family: var(--font-mono);
    font-weight: 500;
    padding: var(--space-xs) var(--space-sm);
    border-radius: var(--radius-sm);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .status-draft {
    background: rgba(156, 163, 175, 0.2);
    color: var(--color-text-secondary);
  }

  .status-preprint {
    background: rgba(139, 92, 246, 0.2);
    color: #a78bfa;
  }

  .status-review {
    background: rgba(251, 191, 36, 0.2);
    color: #fbbf24;
  }

  .status-published {
    background: rgba(34, 197, 94, 0.2);
    color: #22c55e;
  }

  .research-date {
    font-size: var(--text-sm);
    font-family: var(--font-mono);
    color: var(--color-text-muted);
  }

  .research-link {
    text-decoration: none;
    color: inherit;
  }

  .research-title {
    font-size: var(--text-xl);
    font-weight: 600;
    color: var(--color-text);
    margin: 0;
    transition: color 0.2s ease;
  }

  .research-link:hover .research-title {
    color: var(--color-accent);
  }

  .research-venue {
    font-size: var(--text-sm);
    color: var(--color-accent);
    margin: var(--space-xs) 0 0 0;
    font-style: italic;
  }

  .research-abstract {
    font-size: var(--text-sm);
    color: var(--color-text-secondary);
    margin: var(--space-md) 0 0 0;
    line-height: 1.7;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .research-authors {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    margin: var(--space-sm) 0 0 0;
  }

  .research-links {
    display: flex;
    gap: var(--space-md);
    margin-top: var(--space-lg);
    flex-wrap: wrap;
  }

  .paper-link {
    font-size: var(--text-sm);
    font-family: var(--font-mono);
    color: var(--color-accent);
    text-decoration: none;
    padding: var(--space-xs) var(--space-sm);
    border: 1px solid var(--color-accent);
    border-radius: var(--radius-sm);
    transition: all 0.2s ease;
  }

  .paper-link:hover {
    background: var(--color-accent);
    color: var(--color-bg);
  }

  .pdf-link {
    color: #ef4444;
    border-color: #ef4444;
  }

  .pdf-link:hover {
    background: #ef4444;
    color: white;
  }

  .arxiv-link {
    color: #b31b1b;
    border-color: #b31b1b;
  }

  .arxiv-link:hover {
    background: #b31b1b;
    color: white;
  }
</style>
