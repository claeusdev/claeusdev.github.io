---
import { type CollectionEntry, getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import ViewCounter from "../../components/ViewCounter.astro";
import { AUTHOR } from "../../consts";

export async function getStaticPaths() {
  const research = await getCollection("research");
  return research.map((paper) => ({
    params: { slug: paper.slug },
    props: paper,
  }));
}

type Props = CollectionEntry<"research">;

const paper = Astro.props;
const { Content } = await paper.render();

function formatDate(date: Date): string {
  return date.toLocaleDateString("en-US", {
    year: "numeric",
    month: "long",
    day: "numeric",
  });
}

function getStatusBadge(status: string | undefined) {
  const statusMap: Record<string, { label: string; class: string }> = {
    draft: { label: "Draft", class: "status-draft" },
    preprint: { label: "Preprint", class: "status-preprint" },
    "in-review": { label: "In Review", class: "status-review" },
    published: { label: "Published", class: "status-published" },
  };
  return statusMap[status || "draft"] || statusMap.draft;
}

// Calculate reading time
const words = paper.body.split(/\s+/).length;
const readingTime = Math.ceil(words / 200);

// Get author and tags
const author = paper.data.author || AUTHOR;
const tags = paper.data.tags || [];
const status = getStatusBadge(paper.data.publicationStatus);
---

<BaseLayout
  title={paper.data.title}
  description={paper.data.abstract || paper.data.description}
  image={paper.data.image}
>
  <div class="container">
    <article>
      <header class="paper-header">
        <span class={`status-badge ${status.class}`}>{status.label}</span>

        <h1 class="paper-title">{paper.data.title}</h1>

        {paper.data.venue && <p class="paper-venue">{paper.data.venue}</p>}

        <div class="paper-authors">
          <span class="author primary">{author}</span>
          {
            paper.data.coAuthors && paper.data.coAuthors.length > 0 && (
              <>
                {paper.data.coAuthors.map((coAuthor: string) => (
                  <span class="author">{coAuthor}</span>
                ))}
              </>
            )
          }
        </div>

        {
          paper.data.institution && (
            <p class="paper-institution">{paper.data.institution}</p>
          )
        }

        <p class="paper-meta">
          <time datetime={paper.data.date.toISOString()}>
            {formatDate(paper.data.date)}
          </time>
          <span> · </span>
          <span>{readingTime} min read</span>
          <span> · </span>
          <ViewCounter slug={`research-${paper.slug}`} />
        </p>

        <div class="paper-links">
          {
            paper.data.pdfUrl && (
              <a
                href={paper.data.pdfUrl}
                class="paper-link pdf-link"
                target="_blank"
                rel="noopener"
              >
                📄 Download PDF
              </a>
            )
          }
          {
            paper.data.arxivUrl && (
              <a
                href={paper.data.arxivUrl}
                class="paper-link arxiv-link"
                target="_blank"
                rel="noopener"
              >
                📚 View on arXiv
              </a>
            )
          }
        </div>

        {
          tags.length > 0 && (
            <div class="paper-tags">
              {tags.map((tag: string) => (
                <span class="tag">{tag}</span>
              ))}
            </div>
          )
        }
      </header>

      {
        paper.data.abstract && (
          <section class="paper-abstract">
            <h2>Abstract</h2>
            <p>{paper.data.abstract}</p>
          </section>
        )
      }

      <div class="paper-content">
        <Content />
      </div>
    </article>

    <hr />

    <nav class="paper-nav">
      <a href="/research" class="section-link">← Back to all research</a>
    </nav>
  </div>
</BaseLayout>

<style>
  .paper-header {
    padding: var(--space-2xl) 0 var(--space-xl);
    text-align: center;
    max-width: 800px;
    margin: 0 auto;
  }

  .status-badge {
    display: inline-block;
    font-size: var(--text-xs);
    font-family: var(--font-mono);
    font-weight: 500;
    padding: var(--space-xs) var(--space-sm);
    border-radius: var(--radius-sm);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: var(--space-md);
  }

  .status-draft {
    background: rgba(156, 163, 175, 0.2);
    color: var(--color-text-secondary);
  }

  .status-preprint {
    background: rgba(139, 92, 246, 0.2);
    color: #a78bfa;
  }

  .status-review {
    background: rgba(251, 191, 36, 0.2);
    color: #fbbf24;
  }

  .status-published {
    background: rgba(34, 197, 94, 0.2);
    color: #22c55e;
  }

  .paper-title {
    font-size: var(--text-3xl);
    font-weight: 700;
    line-height: 1.2;
    margin: 0;
    background: var(--gradient-accent);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .paper-venue {
    font-size: var(--text-lg);
    color: var(--color-accent);
    margin: var(--space-md) 0 0 0;
    font-style: italic;
  }

  .paper-authors {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-md);
    margin: var(--space-lg) 0;
  }

  .author {
    font-size: var(--text-base);
    color: var(--color-text-secondary);
  }

  .author.primary {
    font-weight: 600;
    color: var(--color-text);
  }

  .author:not(:last-child)::after {
    content: ",";
  }

  .paper-institution {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    margin: 0;
  }

  .paper-meta {
    font-size: var(--text-sm);
    color: var(--color-text-secondary);
    margin-top: var(--space-lg);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: var(--space-xs);
  }

  .paper-links {
    display: flex;
    justify-content: center;
    gap: var(--space-md);
    margin: var(--space-lg) 0;
    flex-wrap: wrap;
  }

  .paper-link {
    font-size: var(--text-sm);
    font-family: var(--font-mono);
    text-decoration: none;
    padding: var(--space-sm) var(--space-md);
    border-radius: var(--radius-md);
    transition: all 0.2s ease;
  }

  .pdf-link {
    background: #ef4444;
    color: white;
  }

  .pdf-link:hover {
    background: #dc2626;
    transform: translateY(-2px);
  }

  .arxiv-link {
    background: #b31b1b;
    color: white;
  }

  .arxiv-link:hover {
    background: #991b1b;
    transform: translateY(-2px);
  }

  .paper-tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm);
    margin-top: var(--space-md);
    justify-content: center;
  }

  .tag {
    font-size: var(--text-xs);
    font-family: var(--font-mono);
    background-color: var(--color-bg-secondary);
    border: 1px solid var(--color-border);
    padding: var(--space-xs) var(--space-sm);
    border-radius: var(--radius-sm);
    color: var(--color-text-secondary);
  }

  .paper-abstract {
    max-width: 700px;
    margin: var(--space-xl) auto;
    padding: var(--space-lg);
    background: var(--color-bg-secondary);
    border: 1px solid var(--color-border);
    border-left: 4px solid var(--color-accent);
    border-radius: var(--radius-md);
  }

  .paper-abstract h2 {
    font-size: var(--text-sm);
    font-family: var(--font-mono);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-accent);
    margin: 0 0 var(--space-md) 0;
  }

  .paper-abstract p {
    font-size: var(--text-base);
    color: var(--color-text-secondary);
    line-height: 1.8;
    margin: 0;
  }

  .paper-content {
    max-width: 700px;
    margin: 0 auto;
    padding: var(--space-xl) 0;
  }

  .paper-nav {
    padding: var(--space-xl) 0;
  }
</style>
