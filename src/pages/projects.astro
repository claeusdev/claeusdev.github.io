---
import BaseLayout from "../layouts/BaseLayout.astro";
import { PROJECTS } from "../consts";
---

<BaseLayout
  title="Projects"
  description="Selected software projects in programming languages, systems, and tooling."
>
  <div class="container">
    <section class="hero" style="padding-bottom: var(--space-lg);">
      <h1 class="hero-title">Projects</h1>
      <p class="hero-subtitle">
        Selected software projects in programming languages, systems, and
        tooling.
      </p>
    </section>

    <section class="section">
      <div class="section-header">
        <h2 class="section-title">Selected Work</h2>
      </div>
      <div class="project-list">
        {
          PROJECTS.map((project) => (
            <div class="project-item">
              <a
                href={project.url}
                class="project-name"
                target="_blank"
                rel="noopener"
              >
                {project.name}
              </a>
              <p class="project-description">{project.description}</p>
              {project.tags && (
                <p class="project-tags">
                  Areas: {project.tags.join(", ")}
                </p>
              )}
            </div>
          ))
        }
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .project-tags {
    margin-top: var(--space-xs);
    font-size: var(--text-sm);
    font-family: var(--font-mono);
    color: var(--color-text-muted);
    margin-bottom: 0;
  }
</style>
