---
import { type CollectionEntry, getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import ViewCounter from "../../components/ViewCounter.astro";
import { AUTHOR } from "../../consts";

export async function getStaticPaths() {
  const essays = await getCollection("essays");
  return essays.map((essay) => ({
    params: { slug: essay.slug },
    props: essay,
  }));
}

type Props = CollectionEntry<"essays">;

const essay = Astro.props;
const { Content } = await essay.render();

function formatDate(date: Date): string {
  return date.toLocaleDateString("en-US", {
    year: "numeric",
    month: "long",
    day: "numeric",
  });
}

// Calculate reading time
const words = essay.body.split(/\s+/).length;
const readingTime = Math.ceil(words / 200);

// Get author and tags
const author = essay.data.author || AUTHOR;
const tags = essay.data.tags || [];
---

<BaseLayout
  title={essay.data.title}
  description={essay.data.description}
  image={essay.data.image}
>
  <div class="container">
    <article>
      <header class="essay-header">
        <h1 class="essay-title">{essay.data.title}</h1>
        {
          essay.data.subtitle && (
            <p class="essay-subtitle">{essay.data.subtitle}</p>
          )
        }
        <p class="essay-meta">
          <span class="essay-author">By {author}</span>
          <span> · </span>
          <time datetime={essay.data.date.toISOString()}>
            {formatDate(essay.data.date)}
          </time>
          <span> · </span>
          <span>{readingTime} min read</span>
          <span> · </span>
          <ViewCounter slug={`essays-${essay.slug}`} />
        </p>
        {
          tags.length > 0 && (
            <div class="essay-tags">
              {tags.map((tag: string) => (
                <span class="tag">{tag}</span>
              ))}
            </div>
          )
        }
      </header>

      <div class="essay-content">
        <Content />
      </div>
    </article>

    <hr />

    <nav class="essay-nav">
      <a href="/essays" class="section-link">← Back to all essays</a>
    </nav>
  </div>
</BaseLayout>

<style>
  .essay-header {
    padding: var(--space-2xl) 0 var(--space-xl);
    text-align: center;
    max-width: 800px;
    margin: 0 auto;
  }

  .essay-title {
    font-size: var(--text-4xl);
    font-weight: 700;
    line-height: 1.2;
    margin: 0;
    background: var(--gradient-accent);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .essay-subtitle {
    font-size: var(--text-xl);
    color: var(--color-text-secondary);
    margin: var(--space-md) 0 0 0;
    font-style: italic;
  }

  .essay-meta {
    font-size: var(--text-sm);
    color: var(--color-text-secondary);
    margin-top: var(--space-lg);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: var(--space-xs);
  }

  .essay-author {
    font-weight: 500;
    color: var(--color-text);
  }

  .essay-tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm);
    margin-top: var(--space-md);
    justify-content: center;
  }

  .tag {
    font-size: var(--text-xs);
    font-family: var(--font-mono);
    background-color: var(--color-bg-secondary);
    border: 1px solid var(--color-border);
    padding: var(--space-xs) var(--space-sm);
    border-radius: var(--radius-sm);
    color: var(--color-text-secondary);
  }

  .essay-content {
    max-width: 700px;
    margin: 0 auto;
    padding: var(--space-xl) 0;
  }

  .essay-nav {
    padding: var(--space-xl) 0;
  }
</style>
