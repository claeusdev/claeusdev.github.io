---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getTagMap } from "../../lib/tags";

const tagMap = await getTagMap();
const tags = [...tagMap.values()].sort(
  (a, b) => b.posts.length - a.posts.length || a.name.localeCompare(b.name)
);
---

<BaseLayout title="Tags" description="Browse posts by topic.">
  <div class="container">
    <section class="hero" style="padding-bottom: var(--space-lg);">
      <h1 class="hero-title">Tags</h1>
      <p class="hero-subtitle">Browse posts by topic.</p>
    </section>

    {
      tags.length === 0 ? (
        <p>No tags yet.</p>
      ) : (
        <ul class="tag-cloud">
          {tags.map((tag) => (
            <li>
              <a href={`/tags/${tag.slug}/`} class="tag-chip">
                {tag.name}
                <span class="tag-count">{tag.posts.length}</span>
              </a>
            </li>
          ))}
        </ul>
      )
    }
  </div>
</BaseLayout>

<style>
  .tag-cloud {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm);
    list-style: none;
    padding: 0;
    margin: var(--space-lg) 0;
  }

  .tag-chip {
    display: inline-flex;
    align-items: center;
    gap: var(--space-xs);
    font-size: var(--text-sm);
    font-family: var(--font-mono);
    padding: var(--space-xs) var(--space-sm);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    color: var(--color-text-secondary);
    text-decoration: none;
    transition: border-color 0.2s ease, color 0.2s ease;
  }

  .tag-chip:hover {
    border-color: var(--color-accent);
    color: var(--color-accent);
  }

  .tag-count {
    font-size: var(--text-xs);
    color: var(--color-text-muted);
  }
</style>
