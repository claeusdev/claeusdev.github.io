---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getTagMap, type Tag } from "../../lib/tags";

export async function getStaticPaths() {
  const tagMap = await getTagMap();
  return [...tagMap.values()].map((tag) => ({
    params: { tag: tag.slug },
    props: { tag },
  }));
}

type Props = { tag: Tag };
const { tag } = Astro.props;

function formatDate(date: Date): string {
  return date.toLocaleDateString("en-US", {
    year: "numeric",
    month: "short",
    day: "numeric",
  });
}
---

<BaseLayout
  title={`Posts tagged "${tag.name}"`}
  description={`All posts tagged ${tag.name}.`}
>
  <div class="container">
    <section class="hero" style="padding-bottom: var(--space-lg);">
      <p class="eyebrow">Tag</p>
      <h1 class="hero-title">{tag.name}</h1>
      <p class="hero-subtitle">
        {tag.posts.length}
        {tag.posts.length === 1 ? "post" : "posts"}
      </p>
    </section>

    <ul class="post-bullets">
      {
        tag.posts.map((post) => (
          <li>
            <a href={`/posts/${post.slug}/`}>{post.data.title}</a>
            <span class="post-date-inline">, {formatDate(post.data.date)}</span>
          </li>
        ))
      }
    </ul>

    <p style="margin-top: var(--space-xl);">
      <a href="/tags">← All tags</a>
    </p>
  </div>
</BaseLayout>

<style>
  .eyebrow {
    font-size: var(--text-xs);
    font-family: var(--font-mono);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-text-muted);
    margin: 0 0 var(--space-xs);
  }

  .post-bullets {
    margin: var(--space-md) 0;
    padding-left: 2rem;
    list-style: disc;
  }

  .post-bullets li {
    margin-bottom: var(--space-sm);
  }

  .post-date-inline {
    color: var(--color-text-muted);
    font-size: var(--text-sm);
  }
</style>
