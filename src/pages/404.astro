---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Page not found" description="The page you're looking for doesn't exist.">
  <div class="container">
    <section class="notfound">
      <p class="notfound-code">404</p>
      <h1 class="notfound-title">This page wandered off.</h1>
      <p class="notfound-text">
        The page you're looking for doesn't exist or may have moved. Let's get
        you back on track.
      </p>
      <div class="notfound-links">
        <a href="/" class="notfound-link">← Home</a>
        <a href="/posts" class="notfound-link">Read the blog</a>
        <a href="/search" class="notfound-link">Search</a>
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .notfound {
    padding: var(--space-3xl) 0;
    text-align: center;
  }

  .notfound-code {
    font-family: var(--font-mono);
    font-size: var(--text-3xl);
    font-weight: 700;
    color: var(--color-accent);
    margin: 0;
  }

  .notfound-title {
    font-size: var(--text-2xl);
    margin: var(--space-md) 0 var(--space-sm);
  }

  .notfound-text {
    color: var(--color-text-secondary);
    max-width: 36rem;
    margin: 0 auto var(--space-xl);
  }

  .notfound-links {
    display: flex;
    gap: var(--space-lg);
    justify-content: center;
    flex-wrap: wrap;
  }

  .notfound-link {
    font-size: var(--text-sm);
    font-family: var(--font-mono);
  }
</style>
