---
import { SITE_TITLE } from "../consts";
import { getCollection } from "astro:content";

const currentPath = Astro.url.pathname;

// Only surface Research/Essays in the nav once they have published content,
// so we never link to an empty section.
const hasPublished = async (name: "research" | "essays") =>
  (await getCollection(name)).some((entry) => !entry.data.draft);
const [hasResearch, hasEssays] = await Promise.all([
  hasPublished("research"),
  hasPublished("essays"),
]);

const navLinks = [
  { href: "/about", label: "about" },
  ...(hasResearch ? [{ href: "/research", label: "research" }] : []),
  { href: "/posts", label: "writing" },
  ...(hasEssays ? [{ href: "/essays", label: "essays" }] : []),
  { href: "/projects", label: "projects" },
  { href: "/experience", label: "cv" },
];
---

<header class="header">
  <div class="header-inner">
    <a href="/" class="logo">{SITE_TITLE}</a>
    <nav class="nav">
      {
        navLinks.map((link) => (
          <a
            href={link.href}
            class:list={[
              "nav-link",
              {
                active:
                  currentPath === link.href ||
                  (link.href !== "/" && currentPath.startsWith(link.href)),
              },
            ]}
            aria-current={
              currentPath === link.href ||
              (link.href !== "/" && currentPath.startsWith(link.href))
                ? "page"
                : undefined
            }
          >
            {link.label}
          </a>
        ))
      }
      <a
        href="/search"
        class="nav-icon"
        aria-label="Search"
        title="Search"
        aria-current={currentPath.startsWith("/search") ? "page" : undefined}
      >
        <svg
          width="18"
          height="18"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <circle cx="11" cy="11" r="7"></circle>
          <path d="M21 21l-4.35-4.35"></path>
        </svg>
      </a>
      <button
        id="theme-toggle"
        type="button"
        class="theme-toggle"
        aria-label="Toggle dark mode"
        title="Toggle dark mode"
      >
        <svg
          class="icon-sun"
          width="18"
          height="18"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <circle cx="12" cy="12" r="4"></circle>
          <path
            d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"
          ></path>
        </svg>
        <svg
          class="icon-moon"
          width="18"
          height="18"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
        </svg>
      </button>
    </nav>
  </div>
</header>
