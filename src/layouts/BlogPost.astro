---
import BaseLayout from "./BaseLayout.astro";

interface Props {
  title: string;
  date: Date;
}

const { title, date } = Astro.props;

function formatDate(date: Date): string {
  return date.toLocaleDateString("en-US", {
    day: "2-digit",
    month: "short",
    year: "numeric",
  });
}
---

<BaseLayout title={title}>
  <div id="post">
    <h1>{title}</h1>
    <p class="meta">{formatDate(date)}</p>
    <slot />
  </div>
</BaseLayout>
